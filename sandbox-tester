#!/usr/bin/env bash
# 沙盒账号自动创建脚本入口
# 兼容两种分发方式：
#   ① npm i -g sandbox-tester —— playwright 装在脚本同目录 node_modules/，直接跑
#   ② git clone / tarball     —— playwright 装到 ~/.local/state/sandbox-tester/node_modules/
#                                 （不让 17M 依赖跟着脚本进 git/同步盘）

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "❌ 未检测到 Node.js，请先安装：brew install node" >&2
  exit 1
fi

if [ ! -d "/Applications/Google Chrome.app" ] && [ ! -d "/Applications/Microsoft Edge.app" ]; then
  echo "❌ 未检测到 Chrome 或 Edge，请安装其中一个（脚本不支持 Safari，因 Playwright 不支持驱动 Safari）" >&2
  exit 1
fi

# 用 node 解析 symlink 拿到脚本真实所在目录
# 必要原因：npm i -g 后 PATH 里的 sandbox-tester 是 symlink 指向 lib/node_modules/.../sandbox-tester，
#         macOS 的 readlink 不支持 -f，纯 bash dirname 也不会 follow symlink，统一交给 node 处理
SCRIPT_PATH="$(node -e 'console.log(require("fs").realpathSync(process.argv[1]))' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

# ① npm i -g：依赖已在脚本同目录，直接跑
if [ -d "$SCRIPT_DIR/node_modules/playwright" ]; then
  exec node "$SCRIPT_DIR/sandbox-tester.js" "$@"
fi

# ② git clone / tarball：依赖装到 STATE_DIR 隔离
STATE_DIR="$HOME/.local/state/sandbox-tester"
mkdir -p "$STATE_DIR"
if [ ! -d "$STATE_DIR/node_modules/playwright" ]; then
  echo "首次运行，安装依赖（约 30 秒）..."
  cp "$SCRIPT_DIR/package.json" "$STATE_DIR/package.json"
  (cd "$STATE_DIR" && npm install --silent)
fi

exec env NODE_PATH="$STATE_DIR/node_modules" node "$SCRIPT_DIR/sandbox-tester.js" "$@"
